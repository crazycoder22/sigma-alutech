# Postgres connection string.
# Local dev:  postgres://sigma:sigma@localhost:55432/sigma  (docker container sigma-pg)
# Production: Neon / Vercel Postgres connection string (with sslmode=require)
DATABASE_URL=

# 32+ char random string used to sign admin session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Vercel Blob read-write token. Set automatically when you add a Blob store
# to the Vercel project. When absent, uploads are stored on the local
# filesystem under public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# Used by the one-time seed script to create the first admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# WhatsApp Business (Meta Cloud API). While WHATSAPP_PROVIDER is unset or
# "mock", payslip delivery runs in simulation: every send is validated and
# recorded, but nothing reaches an employee. Set it to "meta" to go live.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=payslip_notification
WHATSAPP_TEMPLATE_LANG=en
