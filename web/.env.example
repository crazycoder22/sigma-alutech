# Postgres connection string.
# Local dev:  postgres://sigma:sigma@localhost:55432/sigma  (docker container sigma-pg)
# Production: Neon / Vercel Postgres connection string (with sslmode=require)
DATABASE_URL=

# 32+ char random string used to sign admin session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Vercel Blob read-write token. Set automatically when you add a Blob store
# to the Vercel project. When absent, uploads are stored on the local
# filesystem under public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# Used by the one-time seed script to create the first admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API)
#
# While WHATSAPP_PROVIDER is anything but "meta", payslip delivery runs in
# simulation: every send is validated and recorded against the payslip line,
# but nothing reaches an employee. /admin/whatsapp shows what is still
# missing and can send a single test message.
#
# After changing any of these in Vercel you must redeploy — a running
# deployment keeps the values it was built with.
# ---------------------------------------------------------------------------

# "mock" (default) or "meta".
WHATSAPP_PROVIDER=mock

# Meta app → WhatsApp → API setup → "Phone number ID".
# This is a long number, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# A permanent System User token with the whatsapp_business_messaging
# permission. The temporary token on the API setup page expires in 24 hours
# and is only good for a first test.
WHATSAPP_TOKEN=

# Name and language of the approved message template. Must match Meta
# exactly — see "Payroll and payslips" in README.md for the template body to
# submit, which has to line up with what the code sends.
WHATSAPP_TEMPLATE=payslip_notification
WHATSAPP_TEMPLATE_LANG=en

# Any string you invent. Paste the same one into
# Meta → WhatsApp → Configuration → Webhook → "Verify token".
WHATSAPP_VERIFY_TOKEN=

# Meta app → Settings → Basic → App secret. Signs the delivery callbacks.
# Without it the webhook refuses every request, since it cannot tell Meta
# from anyone else who found the URL.
WHATSAPP_APP_SECRET=

# Optional: pin the Graph API version. Defaults to v21.0.
WHATSAPP_GRAPH_VERSION=
