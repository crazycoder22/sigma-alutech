# Postgres connection string.
# Local dev:  postgres://sigma:sigma@localhost:55432/sigma  (docker container sigma-pg)
# Production: Neon / Vercel Postgres connection string (with sslmode=require)
DATABASE_URL=

# 32+ char random string used to sign admin session cookies.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Vercel Blob read-write token. Set automatically when you add a Blob store
# to the Vercel project. When absent, uploads are stored on the local
# filesystem under public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# Used by the one-time seed script to create the first admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API)
#
# While WHATSAPP_PROVIDER is anything but "meta", payslip delivery runs in
# simulation: every send is validated and recorded against the payslip line,
# but nothing reaches an employee. /admin/whatsapp shows what is still
# missing and can send a single test message.
#
# After changing any of these in Vercel you must redeploy — a running
# deployment keeps the values it was built with.
# ---------------------------------------------------------------------------

# "mock" (default), "meta" (WhatsApp Cloud API, direct) or "twilio".
#
# Twilio and Meta reach the same network. Twilio brokers the relationship
# and gives you a sandbox to send from today, before Meta has verified the
# business — useful for proving the wiring. Neither removes the need for an
# approved template on a real salary day: payslips are business-initiated,
# and those are never free text.
WHATSAPP_PROVIDER=mock

# Meta app → WhatsApp → API setup → "Phone number ID".
# This is a long number, not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# A permanent System User token with the whatsapp_business_messaging
# permission. The temporary token on the API setup page expires in 24 hours
# and is only good for a first test.
WHATSAPP_TOKEN=

# Name and language of the approved message template. Must match Meta
# exactly — see "Payroll and payslips" in README.md for the template body to
# submit, which has to line up with what the code sends.
WHATSAPP_TEMPLATE=payslip_notification
WHATSAPP_TEMPLATE_LANG=en

# Any string you invent. Paste the same one into
# Meta → WhatsApp → Configuration → Webhook → "Verify token".
WHATSAPP_VERIFY_TOKEN=

# Meta app → Settings → Basic → App secret. Signs the delivery callbacks.
# Without it the webhook refuses every request, since it cannot tell Meta
# from anyone else who found the URL.
WHATSAPP_APP_SECRET=

# Optional: pin the Graph API version. Defaults to v21.0.
WHATSAPP_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Twilio — only read when WHATSAPP_PROVIDER=twilio
# ---------------------------------------------------------------------------

# Twilio console → Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The WhatsApp sender in E.164. The sandbox number works for testing;
# recipients must first join the sandbox by texting its code.
TWILIO_WHATSAPP_FROM=

# An approved Content template (starts HX). Leave blank and Twilio sends
# plain text, which WhatsApp only allows inside a 24-hour session window —
# sandbox testing only.
TWILIO_CONTENT_SID=

# Only if the template takes the PDF as a content variable rather than as
# media, e.g. "4".
TWILIO_MEDIA_VARIABLE=

# Full https URL of /api/whatsapp/webhook/twilio. Sent with every message,
# and the URL Twilio signs — it must match exactly.
TWILIO_STATUS_CALLBACK=

# ---------------------------------------------------------------------------
# SMS — only read when WHATSAPP_PROVIDER=sms
#
# No attachment is possible, so the figures travel in the message body and
# the payslip is a link. Uses the same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
# as the WhatsApp path.
#
# For Indian recipients this is subject to TRAI's DLT regime: the entity,
# the sender header and the message template must all be registered, and
# URLs generally have to be whitelisted. Unregistered traffic is scrubbed by
# the carriers — it does not bounce, it simply never arrives. Confirm the
# current requirements with Twilio before relying on it.
# ---------------------------------------------------------------------------

# Preferred: a Messaging Service carries the DLT identifiers. Starts MG.
TWILIO_MESSAGING_SERVICE_SID=

# Used only when no Messaging Service is set.
TWILIO_SMS_FROM=
